# Copiar para .env e preencher com os mesmos valores usados no MySQL que já
# está rodando na VPS (repositório zap-agenda) — ver docker-compose.yml
# deste repositório: o volume do banco é reaproveitado (external), então
# essas credenciais precisam bater com o que já está gravado nele.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Usuário exclusivo do PDV, com acesso somente aos bancos sistem84_*.
PDV_DB_USER=pdv_app
PDV_DB_PASSWORD=
